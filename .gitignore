# Python
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.venv/
dist/
build/
*.egg-info/

# Secrets and local settings
.env
*.local.yaml

# Experiment tracking
wandb/
mlruns/

# Raw and generated images/annotations
data/*/raw/*
!data/*/raw/.gitkeep
data/*/synthetic/*/*/images/*
data/*/synthetic/*/*/annotations/*

# Large checkpoints
checkpoints/**/*.pt
checkpoints/**/*.pth
checkpoints/**/*.ckpt
checkpoints/**/*.safetensors

# Per-run artifacts
outputs/*
!outputs/README.md

# Temporary aggregate files
results/**/*.tmp
results/**/*.parquet
